{
  "name": "vue-ai-project-management-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "dev:full": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start:server": "node server/index.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "vite": "latest",
    "vue": "latest",
    "vue-router": "latest",
    "pinia": "latest",
    "@lucide/vue": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vue-tsc": "latest",
    "@tailwindcss/postcss": "latest",
    "concurrently": "latest"
  }
}
